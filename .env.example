# Aletheia — configuration template. Copy to .env and fill in; set the same
# names as env vars on Vercel (dashboard → Settings → Environment Variables).

# ---- mode ----
# razorpay = Standard Checkout + hosted Payment Button (global, cards/UPI/netbanking)
# upi      = plain UPI QR (0% fees), payments verified manually in the admin panel
# off      = refuse new bookings (no payment provider configured)
# Without this override the mode is chosen automatically:
#   live Razorpay keys > UPI_ID > test Razorpay keys > off
PAYMENT_MODE=

# ---- Razorpay (dashboard.razorpay.com → Account & Settings → API Keys) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Dashboard → Settings → Webhooks → URL https://<site>/webhook,
# subscribe payment.captured + payment_link.paid). Leave empty to reject all webhooks.
RAZORPAY_WEBHOOK_SECRET=
# Hosted Payment Button ID (Dashboard → Payment Buttons) shown on the pay page;
# its payments are confirmed manually (they are not bound to a ticket).
RAZORPAY_BUTTON_ID=

# ---- UPI fallback mode ----
UPI_ID=

# ---- event ----
# Registration closes at the end of this day (day before the event).
REG_DEADLINE=2026-11-20

# ---- admin + database ----
ADMIN_KEY=
# Upstash Redis REST (cloud DB used on Vercel — local uses data/db.json)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- ticket + invite emails (Gmail app password; REQUIRED for the email-first flow) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Email-first flow: start page collects email + topic interests and mails a
# personal registration link. Set 0 to disable and use open registration.
REQUIRE_EMAIL_LINK=1

# ---- misc ----
# Leave EMPTY on Vercel (auto-detects the deployment domain). Locally set only
# when exposing the app through a tunnel.
PUBLIC_BASE_URL=
PORT=3000
# Local development only — demo "simulate payment" button.
ALLOW_DEMO=
